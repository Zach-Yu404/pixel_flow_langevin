{
 "mode": "debug_box",
 "paths": {
  "model_dir": "{IP_PACKAGE}/pretrained_models/c2img",
  "demo_dir": "{IP_PACKAGE}/demo",
  "gamma2_table": "{HERE}/gamma2_meas.json"
 },
 "algorithm": {
  "sigma_min": 0.01,
  "h0": 0.1,
  "x0_langevin_steps": 1,
  "gamma2_scale": 1.0,
  "anchor": 0.0,
  "seed": 42,
  "ridge_rel": 1e-06,
  "cg_max_iter_l14": 50
 },
 "sampler_kw": {
  "num_langevin": 10,
  "ode_steps_per_stage": 10,
  "shift": 1.0,
  "guidance_scale": 2.0,
  "g_bypass_stage3": true,
  "cg_tol": 1e-05,
  "cg_max_iter": 50
 },
 "tasks_setup": {
  "box_inpainting": {
   "sigma_n": 0.05,
   "operator": {
    "mask_len_range": [
     128,
     129
    ]
   },
   "terminal_replace_weight": 0.0
  },
  "random_inpainting": {
   "sigma_n": 0.05,
   "operator": {
    "mask_prob": 0.7
   },
   "kw": {
    "num_langevin": 15
   },
   "terminal_replace_weight": 0.0
  },
  "gaussian_blur": {
   "sigma_n": 0.05,
   "operator": {
    "kernel_size": 61,
    "kernel_std": 3.0
   },
   "terminal_replace_weight": 0.0
  },
  "motion_blur": {
   "sigma_n": 0.05,
   "operator": {
    "kernel_size": 61,
    "kernel_intensity": 0.5,
    "kernel_seed": 42,
    "use_daps_kernel": true
   },
   "terminal_replace_weight": 0.0
  },
  "superresolution": {
   "sigma_n": 0.05,
   "operator": {
    "scale_factor": 4,
    "antialias": true
   },
   "terminal_replace_weight": 0.0
  }
 },
 "tasks": [
  "box_inpainting",
  "random_inpainting",
  "gaussian_blur",
  "motion_blur",
  "superresolution"
 ],
 "images": [
  "breastplate_armor",
  "crane_structure",
  "ibex_horns",
  "junco",
  "lakeside_beach",
  "sea_anemone",
  "shetland_sheepdog"
 ],
 "onestep": {
  "out": "results/onestep",
  "chunk": 4,
  "self_test": false
 },
 "full_ip": {
  "out": "results/full_ip",
  "smoke": false
 },
 "debug_box": {
  "out": "results/debug_box",
  "image": "junco",
  "h0": [
   0.1,
   0.5,
   1.0
  ],
  "anchors": null,
  "x0_steps": [
   1
  ],
  "gamma2_scales": [
   1.0
  ]
 },
 "verify": {
  "res": 16
 }
}