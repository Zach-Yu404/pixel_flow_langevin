#!/usr/bin/env -S python3 -I
"""Run bounded, cacheable Claude/Codex collaboration in an isolated worktree."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any


PHASE_OUTCOMES = {
    "plan": {"ready", "needs_user"},
    "compare": {"consensus", "disagreement", "needs_user"},
    "review": {"approve", "request_changes", "needs_user"},
}
SHARED_INPUTS = (
    ".research/STATE.yaml",
    ".research/CURRENT.md",
    ".research/CONSTRAINTS.md",
    ".research/policy.json",
    ".research/RULES.md",
)


def git(root: Path, *args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        ["git", "-C", str(root), *args],
        capture_output=True,
        text=True,
        errors="replace",
    )
    if check and result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or f"git {' '.join(args)} failed")
    return result


def root_from(path: Path) -> Path:
    result = git(path, "rev-parse", "--show-toplevel")
    return Path(result.stdout.strip()).resolve()


def common_dir(root: Path) -> Path:
    result = git(root, "rev-parse", "--path-format=absolute", "--git-common-dir")
    return Path(result.stdout.strip()).resolve()


def load_policy(root: Path) -> dict[str, Any]:
    path = root / ".research/policy.json"
    try:
        value = json.loads(path.read_text())
        return value if isinstance(value, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def sha256_bytes(*values: bytes) -> str:
    digest = hashlib.sha256()
    for value in values:
        digest.update(len(value).to_bytes(8, "big"))
        digest.update(value)
    return digest.hexdigest()


def read_required(root: Path, relative: str) -> bytes:
    path = (root / relative).resolve()
    try:
        path.relative_to(root)
    except ValueError as exc:
        raise RuntimeError(f"path escapes repository: {relative}") from exc
    if not path.is_file():
        raise RuntimeError(f"required file does not exist: {relative}")
    return path.read_bytes()


def phase_fingerprint(root: Path, args: argparse.Namespace) -> str:
    current_head = git(root, "rev-parse", "HEAD").stdout.strip()
    values = [
        current_head.encode(),
        args.phase.encode(),
        args.agent.encode(),
        args.task.encode(),
        read_required(root, args.task),
        (args.base or "").encode(),
        (args.head or "").encode(),
    ]
    entrypoint = "CLAUDE.md" if args.agent == "claude" else "AGENTS.md"
    for shared in (*SHARED_INPUTS, entrypoint):
        values.extend([shared.encode(), read_required(root, shared)])
    for plan in args.plan or []:
        values.extend([plan.encode(), read_required(root, plan)])
    return sha256_bytes(*values)


def atomic_json(path: Path, value: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    temp.write_text(json.dumps(value, ensure_ascii=False, indent=2) + "\n")
    os.replace(temp, path)


def total_string_chars(value: Any) -> int:
    if isinstance(value, str):
        return len(value)
    if isinstance(value, list):
        return sum(total_string_chars(item) for item in value)
    if isinstance(value, dict):
        return sum(
            total_string_chars(key) + total_string_chars(item)
            for key, item in value.items()
        )
    return 0


def require_string_list(result: dict[str, Any], key: str, limit: int = 8) -> None:
    value = result.get(key)
    if not isinstance(value, list) or len(value) > limit:
        raise RuntimeError(f"peer output {key} must be a list with at most {limit} items")
    if any(not isinstance(item, str) for item in value):
        raise RuntimeError(f"peer output {key} must contain only strings")


def validate_result(
    result: Any,
    args: argparse.Namespace,
    run_id: str,
    char_limit: int,
) -> dict[str, Any]:
    if not isinstance(result, dict):
        raise RuntimeError("peer output must be one JSON object")
    expected = {
        "run_id": run_id,
        "phase": args.phase,
        "agent": args.agent,
        "task": args.task,
    }
    for key, value in expected.items():
        if result.get(key) != value:
            raise RuntimeError(f"peer output {key} must equal {value!r}")
    if result.get("outcome") not in PHASE_OUTCOMES[args.phase]:
        raise RuntimeError(f"invalid {args.phase} outcome")
    if not isinstance(result.get("summary"), str) or not result["summary"].strip():
        raise RuntimeError("peer output requires a non-empty summary")
    if total_string_chars(result) > char_limit:
        raise RuntimeError(f"peer output exceeds {char_limit} character budget")
    if args.phase == "plan":
        for key in ("assumptions", "steps", "risks", "validation"):
            require_string_list(result, key)
    elif args.phase == "compare":
        for key in ("agreements", "differences"):
            require_string_list(result, key)
        if not isinstance(result.get("decision"), str):
            raise RuntimeError("compare output requires a decision string")
    else:
        if result.get("reviewed_sha") != args.head:
            raise RuntimeError("review is not bound to the requested head SHA")
        if result.get("base_sha") != args.base:
            raise RuntimeError("review is not bound to the requested base SHA")
        findings = result.get("findings", [])
        if not isinstance(findings, list):
            raise RuntimeError("review findings must be a list")
        if result["outcome"] == "request_changes" and not findings:
            raise RuntimeError("request_changes requires at least one finding")
        if len(findings) > 8:
            raise RuntimeError("review findings exceed the limit of 8")
        for finding in findings:
            if not isinstance(finding, dict):
                raise RuntimeError("each review finding must be an object")
            if finding.get("severity") not in {"blocking", "major", "minor"}:
                raise RuntimeError("review finding has invalid severity")
            if not isinstance(finding.get("path"), str) or not finding["path"]:
                raise RuntimeError("review finding requires a relative path")
            if Path(finding["path"]).is_absolute() or ".." in Path(finding["path"]).parts:
                raise RuntimeError("review finding path must be repository-relative")
            if not isinstance(finding.get("line"), int) or finding["line"] < 1:
                raise RuntimeError("review finding requires a positive line number")
            if not isinstance(finding.get("message"), str) or not finding["message"]:
                raise RuntimeError("review finding requires a message")
        require_string_list(result, "tests")
    if args.phase == "compare" and result.get("outcome") == "consensus":
        if not isinstance(result.get("implementation_required"), bool):
            raise RuntimeError("consensus requires boolean implementation_required")
    result["source"] = "research-peer"
    if args.phase == "review":
        result["reviewer"] = args.agent
        result["verdict"] = result["outcome"]
    return result


def output_schema(args: argparse.Namespace, run_id: str) -> dict[str, Any]:
    common: dict[str, Any] = {
        "run_id": run_id,
        "phase": args.phase,
        "agent": args.agent,
        "task": args.task,
        "outcome": "one of: " + " | ".join(sorted(PHASE_OUTCOMES[args.phase])),
        "summary": "concise Chinese conclusion",
    }
    if args.phase == "plan":
        common.update({
            "assumptions": ["bounded list"],
            "steps": ["bounded list"],
            "risks": ["bounded list"],
            "validation": ["bounded list"],
        })
    elif args.phase == "compare":
        common.update({
            "implementation_required": True,
            "agreements": ["bounded list"],
            "differences": ["bounded list"],
            "decision": "concise Chinese consensus or user question",
        })
    else:
        common.update({
            "base_sha": args.base,
            "reviewed_sha": args.head,
            "findings": [{
                "severity": "blocking|major|minor",
                "path": "relative/path",
                "line": 1,
                "message": "specific Chinese finding",
            }],
            "tests": ["evidence already available or focused checks run"],
        })
    return common


def prepare_worktree(root: Path, runtime: Path, run_id: str, ref: str, phase: str) -> Path:
    worktree = runtime / "worktrees" / run_id
    worktree.parent.mkdir(parents=True, exist_ok=True)
    if worktree.exists():
        git(root, "worktree", "remove", "--force", str(worktree), check=False)
        shutil.rmtree(worktree, ignore_errors=True)
    git(root, "worktree", "add", "--detach", str(worktree), ref)
    output_dir = worktree / ".research/.runtime"
    output_dir.mkdir(parents=True, exist_ok=True)
    if phase == "plan":
        plans = worktree / ".research/plans"
        if plans.is_dir():
            for path in plans.glob("*.json"):
                path.unlink()
    return worktree


def copy_inputs(root: Path, worktree: Path, args: argparse.Namespace) -> None:
    entrypoint = "CLAUDE.md" if args.agent == "claude" else "AGENTS.md"
    inputs = [*SHARED_INPUTS, entrypoint, args.task, *(args.plan or [])]
    for relative in inputs:
        source = (root / relative).resolve()
        try:
            source.relative_to(root)
        except ValueError as exc:
            raise RuntimeError(f"path escapes repository: {relative}") from exc
        destination = (worktree / relative).resolve()
        try:
            destination.relative_to(worktree)
        except ValueError as exc:
            raise RuntimeError(f"destination escapes isolated worktree: {relative}") from exc
        destination.parent.mkdir(parents=True, exist_ok=True)
        if not destination.is_file() or source.read_bytes() != destination.read_bytes():
            shutil.copyfile(source, destination)


def peer_command(agent: str, prompt: str) -> list[str]:
    if agent == "claude":
        return ["claude", "-p", prompt, "--permission-mode", "acceptEdits"]
