{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.research/bin/research-gate\" stop --agent claude",
            "timeout": 20,
            "statusMessage": "Checking Research OS handoff"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.research/bin/research-gate\" session-start --agent claude",
            "timeout": 10,
            "statusMessage": "Loading Research OS L1"
          }
        ]
      }
    ]
  }
}
